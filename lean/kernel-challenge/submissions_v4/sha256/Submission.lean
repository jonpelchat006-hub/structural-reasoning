import Spec
import Lean

set_option maxRecDepth 100000

/-!
# SHA-256 chain with kernel-cheap word operations (v8)

The kernel pays a large fixed overhead for every `Nat` operation it evaluates (cache lookups, a
linear scan over the list of GMP-accelerated `Nat` functions, recursor checks), plus extra for
every value that does not fit in a machine word, plus the cost of substituting a function's
arguments into its body. This submission minimises all three:

* Word operations call `Nat.add`/`Nat.mul`/`Nat.div`/`Nat.land`/`Nat.xor` directly.
  Right shifts by constants are `Nat.div` by powers of two (the kernel recognises `div` much
  earlier in its list than `shiftRight`). 32-bit masks are `Nat.land 0xffffffff x` with the
  constant first: when the kernel substitutes a step's inputs into its body, an application
  whose first argument is closed is left as is, which saves rebuilding one node per mask.
* A rotation of a 32-bit word reads a window of the word duplicated into 64 bits
  (`x * 0x100000001`). Each Σ/σ shifts the (possibly > 2^63) duplicated word once, and derives
  the other rotations from that small shifted value, so at most one operation per Σ/σ touches
  a multi-limb number. Garbage above bit 31 is harmless because every Σ/σ only feeds a sum that
  is reduced mod `2^32` once.
* The schedule applies `σ₀` and `σ₁` to the same words; `σ₁(x) = (y ⊕ (y >> 2) ⊕ x) >> 10` reuses
  `σ₀`'s `y = dup x >> 7`, one operation less per word.
* `Ch(e,f,g) = g ⊕ (e ∧ (f ⊕ g))` and `Maj(a,b,c) = b ⊕ ((a ⊕ b) ∧ (b ⊕ c))`, where `b ⊕ c` is
  the previous round's `a ⊕ b`.
* The chain state is passed as eight separate words in continuation-passing style, so there is
  no packing or unpacking between steps; the 256-bit number is assembled once at the end.
* One chain step is a single shared expression graph (`stepF`, built by `natdag%`), so the kernel
  evaluates each word operation exactly once; constant parts are folded (`x + 0` is dropped: the
  kernel unfolds `Nat.add x 0` to `x`), and `T1` adds `K + W` first, so rounds with a constant
  schedule word start from a numeral.
* Eight chain steps form one graph (`stepF8`), so the kernel substitutes the chain state into a
  step body once per eight steps; `iterN8` runs groups of eight, then the remaining single steps.

Proof outline:
* Bit-level lemmas (`S1_mod`, `S0_mod`, `s0_mod`, `s1_mod`, `ch_eq`, `maj_eq`) via `testBit`.
* `round_eq`: one fast round equals the spec's `round` on valid (32-bit) inputs.
* `loopA_eq`/`loopB_eq`: the loops equal the spec's `rounds` over the rolling schedule, which
  equals `extendW 48` (adapted from the organizers' worked example).
* `stepN8_eq`: one structured step passes the words of `sha256step d` to its continuation;
  `stepF_eq` (kernel `rfl`) shows the flat graph is the structured step; `stepF8_eq` (kernel
  `rfl`) shows the eight-step graph is eight nested `stepF`s; `iterN_eq` and `iterN8_eq` iterate.
-/

namespace Submission

open Lean Elab Term Meta in
/-- `share x := v; b`: elaborate `b` with every `x` replaced by the same (shared) term `v`. -/
elab "share " x:ident " := " v:term "; " b:term : term => do
  let v ← instantiateMVars (← elabTermEnsuringType v (some (mkConst ``Nat)))
  withLocalDeclD x.getId (mkConst ``Nat) fun fv => do
    let b ← instantiateMVars (← elabTermEnsuringType b (some (mkConst ``Nat)))
    return b.replaceFVar fv v


open Lean Elab Term Meta in
/-- `natdag% "s" [x₀, …]`: the natural-number expression graph described by `s`, built directly as
one shared `Expr` (linear time; the kernel sees the same term as with nested `share`s). Each line of
`s` is `op a b`, with `op` one of `add sub mul div mod land lor xor shl shr` and operands `vN` (the
node on line `N`, counting from 0), `xN` (the `N`-th listed term) or a numeral; the last line,
`app f a₁ … aₙ`, is the result. -/
elab "natdag% " s:str " [" xs:term,* "]" : term => do
  let xs ← xs.getElems.mapM fun x => elabTerm x none
  let ops : Std.HashMap String Name := Std.HashMap.ofList
    [("add", ``Nat.add), ("sub", ``Nat.sub), ("mul", ``Nat.mul), ("div", ``Nat.div), ("mod", ``Nat.mod),
     ("land", ``Nat.land), ("lor", ``Nat.lor), ("xor", ``Nat.xor), ("shl", ``Nat.shiftLeft),
     ("shr", ``Nat.shiftRight)]
  let mut nodes : Array Expr := #[]
  let mut result : Option Expr := none
  let operand := fun (nodes : Array Expr) (t : String) => do
    if t.startsWith "v" then
      let some i := (t.drop 1).toNat? | throwError "natdag%: bad operand {t}"
      let some e := nodes[i]? | throwError "natdag%: unknown node {t}"
      pure e
    else if t.startsWith "x" then
      let some i := (t.drop 1).toNat? | throwError "natdag%: bad operand {t}"
      let some e := xs[i]? | throwError "natdag%: unknown variable {t}"
      pure e
    else
      let some n := t.toNat? | throwError "natdag%: bad operand {t}"
      pure (mkRawNatLit n)
  for line in s.getString.splitOn "\n" do
    let ws := (line.splitOn " ").filter (· ≠ "")
    match ws with
    | [] => pure ()
    | "app" :: f :: args =>
      let fe ← operand nodes f
      let mut es : Array Expr := #[]
      for a in args do es := es.push (← operand nodes a)
      result := some (mkAppN fe es)
    | [op, a, b] =>
      let some c := ops[op]? | throwError "natdag%: unknown op {op}"
      nodes := nodes.push (mkApp2 (mkConst c) (← operand nodes a) (← operand nodes b))
    | _ => throwError "natdag%: bad line {line}"
  match result with
  | some r => pure r
  | none => match nodes.back? with
    | some r => pure r
    | none => throwError "natdag%: empty graph"

/-! ## Implementation -/

/-- Duplicate a 32-bit word into 64 bits: rotations become windows. -/
def dup (x : Nat) : Nat := Nat.mul 0x100000001 x

def S1y (y : Nat) : Nat := Nat.xor (Nat.xor y (Nat.div y 32)) (Nat.div y 524288)
/-- `Σ₁` (plus garbage above bit 31): rotations by 6, 11, 25. -/
def S1 (e : Nat) : Nat := S1y (Nat.div (dup e) 64)
def S0y (y : Nat) : Nat := Nat.xor (Nat.xor y (Nat.div y 2048)) (Nat.div y 1048576)
/-- `Σ₀` (plus garbage above bit 31): rotations by 2, 13, 22. -/
def S0 (a : Nat) : Nat := S0y (Nat.div (dup a) 4)
def s0y (y x : Nat) : Nat := Nat.xor (Nat.xor y (Nat.div y 2048)) (Nat.div x 8)
/-- `σ₀` (plus garbage above bit 31): rotations by 7, 18 and shift by 3. -/
def s0 (x : Nat) : Nat := s0y (Nat.div (dup x) 128) x
/-- `σ₁` (plus garbage above bit 31): rotations by 17, 19 and shift by 10, as one final shift of
`y ⊕ (y >> 2) ⊕ x` with `y = dup x >> 7`. The schedule applies `σ₀` and `σ₁` to the same words, and
`σ₀` uses the same `y`, so `σ₁` costs four operations instead of five. -/
def s1 (x : Nat) : Nat :=
  Nat.div (Nat.xor (Nat.xor (Nat.div (dup x) 128) (Nat.div (Nat.div (dup x) 128) 4)) x) 1024

/-- `T1` before reduction mod `2^32`. -/
def T1 (h e f g k x : Nat) : Nat :=
  Nat.add (Nat.add k x) (Nat.add (Nat.add h (S1 e)) (Nat.xor g (Nat.land e (Nat.xor f g))))
def NA (t1 a b c : Nat) : Nat :=
  Nat.land 4294967295 (Nat.add t1 (Nat.add (S0 a) (Nat.xor b (Nat.land (Nat.xor a b) (Nat.xor b c)))))
def NE (d t1 : Nat) : Nat := Nat.land 4294967295 (Nat.add t1 d)
def NW (x14 x9 x1 x0 : Nat) : Nat :=
  Nat.land 4294967295 (Nat.add (Nat.add (s1 x14) x9) (Nat.add (s0 x1) x0))
/-- Feed-forward of one chaining word. -/
def F32 (c v : Nat) : Nat := Nat.land 4294967295 (Nat.add c v)

/-- The last `n` rounds (no new schedule words); round constants are read from `ks`. At the end the
eight feed-forward words are passed to the continuation `k`. -/
def loopB (n : Nat) : List Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
      Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
      (Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) → Nat :=
  Nat.rec (motive := fun _ => List Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
      Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
      (Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) → Nat)
    (fun _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ a b c d e f g h k =>
      k (F32 0x6a09e667 a) (F32 0xbb67ae85 b) (F32 0x3c6ef372 c) (F32 0xa54ff53a d)
        (F32 0x510e527f e) (F32 0x9b05688c f) (F32 0x1f83d9ab g) (F32 0x5be0cd19 h))
    (fun _ ih ks x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 a b c d e f g h k =>
      let t1 := T1 h e f g (ks.headD 0) x0
      ih ks.tail x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 0 (NA t1 a b c) a b c (NE d t1) e f g k)
    n

/-- The first `n` rounds, each also producing the next schedule word; then 16 more via `loopB`. -/
def loopA (n : Nat) : List Nat → List Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
      Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
      (Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) → Nat :=
  Nat.rec (motive := fun _ => List Nat → List Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
      Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat →
      (Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) → Nat)
    (fun _ kb => loopB 16 kb)
    (fun _ ih ks kb x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 a b c d e f g h k =>
      let t1 := T1 h e f g (ks.headD 0) x0
      ih ks.tail kb x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 (NW x14 x9 x1 x0) (NA t1 a b c)
        a b c (NE d t1) e f g k)
    n

def KA : List Nat := K.take 48
def KB : List Nat := K.drop 48

/-- One chain step (structured form): compress the 8-word message, pass the digest words to `k`. -/
def stepN8 (x0 x1 x2 x3 x4 x5 x6 x7 : Nat) (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) :
    Nat :=
  loopA 48 KA KB x0 x1 x2 x3 x4 x5 x6 x7 0x80000000 0 0 0 0 0 0 256
    0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19 k

/-- One chain step as a single shared expression graph: every intermediate word is one node
(built by `natdag%`), and constant parts are folded to numerals. `stepF_eq` shows it is
definitionally the structured `stepN8`. -/
