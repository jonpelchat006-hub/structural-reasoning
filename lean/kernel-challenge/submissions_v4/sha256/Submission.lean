/-- The final digest as a big-endian number (same shape as the spec's `encodeDigest`). -/
def enc (a b c d e f g h : Nat) : Nat :=
  Nat.add (Nat.mul (Nat.add (Nat.mul (Nat.add (Nat.mul (Nat.add (Nat.mul (Nat.add (Nat.mul (Nat.add (Nat.mul
    (Nat.add (Nat.mul (Nat.add (Nat.mul 0 4294967296) a) 4294967296) b) 4294967296) c) 4294967296) d)
    4294967296) e) 4294967296) f) 4294967296) g) 4294967296) h

/-- `t` chain steps in continuation-passing style. -/
def iterN (t : Nat) : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat)
    (fun a b c d e f g h => enc a b c d e f g h)
    (fun _ ih a b c d e f g h => stepF a b c d e f g h ih) t

/-- `t` groups of eight chain steps (`stepF8`), then `r` single steps (`iterN`). -/
def iterN8 (r t : Nat) : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat)
    (fun a b c d e f g h => iterN r a b c d e f g h)
    (fun _ ih a b c d e f g h => stepF8 a b c d e f g h ih) t

/-- The spec's `seedStep32` with primitive operations. -/
def seedW (x : Nat) : Nat := Nat.land (Nat.add (Nat.mul 1664525 x) 1013904223) 4294967295

def impl (n : Nat) : Nat :=
  share s := Nat.land (Nat.land n 4294967295) 4294967295;
  share w0 := seedW s; share w1 := seedW w0; share w2 := seedW w1; share w3 := seedW w2;
  share w4 := seedW w3; share w5 := seedW w4; share w6 := seedW w5; share w7 := seedW w6;
  iterN8 (Nat.land (Nat.shiftRight n 32) 7) (Nat.shiftRight n 35) w0 w1 w2 w3 w4 w5 w6 w7

/-! ## Bit-level lemmas -/

theorem w32_eq : w32 = 2 ^ 32 - 1 := rfl

theorem land_w32 (x : Nat) : x &&& w32 = x % 2 ^ 32 := by
  rw [w32_eq, Nat.and_two_pow_sub_one_eq_mod]

theorem tb_w32 (i : Nat) : w32.testBit i = decide (i < 32) := by
  rw [w32_eq, Nat.testBit_two_pow_sub_one]

theorem tb_big {x i : Nat} (hx : x < 2 ^ 32) (hi : 32 ≤ i) : x.testBit i = false :=
  Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hx (Nat.pow_le_pow_right (by omega) hi))

theorem dup_eq (x : Nat) (hx : x < 2 ^ 32) : dup x = x <<< 32 ||| x := by
  unfold dup
  rw [← Nat.shiftLeft_add_eq_or_of_lt hx, Nat.shiftLeft_eq]
  show 4294967297 * x = x * 4294967296 + x
  omega

theorem tb_dupShift (x n i : Nat) (hx : x < 2 ^ 32) (hn : n ≤ 32) :
    (Nat.shiftRight (dup x) n).testBit i
      = (x.testBit (i + n) || (decide (32 - n ≤ i) && x.testBit (i - (32 - n)))) := by
  rw [dup_eq x hx]
  show ((x <<< 32 ||| x) >>> n).testBit i = _
  rw [Nat.testBit_shiftRight, Nat.testBit_or, Nat.testBit_shiftLeft, Bool.or_comm]
  rw [Nat.add_comm n i]
  by_cases h : 32 - n ≤ i
  · rw [decide_eq_true (show 32 ≤ i + n by omega), decide_eq_true h,
      show i + n - 32 = i - (32 - n) by omega]
  · rw [decide_eq_false (show ¬ 32 ≤ i + n by omega), decide_eq_false h]
    simp

theorem tb_rotr (x n i : Nat) (_hn : 0 < n) (_hn' : n < 32) :
    (rotr32 x n).testBit i
      = (decide (i < 32) && (x.testBit (i + n) || (decide (32 - n ≤ i) && x.testBit (i - (32 - n))))) := by
  unfold rotr32
  rw [Nat.testBit_and, tb_w32, Nat.testBit_or, Nat.testBit_shiftRight, Nat.testBit_shiftLeft,
    Bool.and_comm, Nat.add_comm n i]

theorem tb_mod32 (x i : Nat) : (x % 2 ^ 32).testBit i = (decide (i < 32) && x.testBit i) :=
  Nat.testBit_mod_two_pow x 32 i

theorem div_div_pow (x a b : Nat) : x / 2 ^ a / 2 ^ b = x / 2 ^ (a + b) := by
  rw [Nat.div_div_eq_div_mul, ← Nat.pow_add]

/-- The one-big-shift forms are the usual three shifts of the duplicated word. -/
theorem S1_alt (e : Nat) : S1 e =
    Nat.xor (Nat.xor (Nat.shiftRight (dup e) 6) (Nat.shiftRight (dup e) 11)) (Nat.shiftRight (dup e) 25) := by
  show Nat.xor (Nat.xor (dup e / 2 ^ 6) (dup e / 2 ^ 6 / 2 ^ 5)) (dup e / 2 ^ 6 / 2 ^ 19) = _
  rw [div_div_pow, div_div_pow]
  simp only [← Nat.shiftRight_eq_div_pow]
  rfl

theorem S0_alt (a : Nat) : S0 a =
    Nat.xor (Nat.xor (Nat.shiftRight (dup a) 2) (Nat.shiftRight (dup a) 13)) (Nat.shiftRight (dup a) 22) := by
  show Nat.xor (Nat.xor (dup a / 2 ^ 2) (dup a / 2 ^ 2 / 2 ^ 11)) (dup a / 2 ^ 2 / 2 ^ 20) = _
  rw [div_div_pow, div_div_pow]
  simp only [← Nat.shiftRight_eq_div_pow]
  rfl

theorem s0_alt (x : Nat) : s0 x =
    Nat.xor (Nat.xor (Nat.shiftRight (dup x) 7) (Nat.shiftRight (dup x) 18)) (Nat.shiftRight x 3) := by
  show Nat.xor (Nat.xor (dup x / 2 ^ 7) (dup x / 2 ^ 7 / 2 ^ 11)) (x / 2 ^ 3) = _
  rw [div_div_pow]
  simp only [← Nat.shiftRight_eq_div_pow]
  rfl

theorem s1_alt (x : Nat) : s1 x =
    Nat.xor (Nat.xor (Nat.shiftRight (dup x) 17) (Nat.shiftRight (dup x) 19)) (Nat.shiftRight x 10) := by
  apply Nat.eq_of_testBit_eq
  intro i
  show (((dup x / 2 ^ 7) ^^^ (dup x / 2 ^ 7 / 2 ^ 2) ^^^ x) / 2 ^ 10).testBit i =
    ((dup x >>> 17) ^^^ (dup x >>> 19) ^^^ (x >>> 10)).testBit i
  rw [div_div_pow]
  simp only [← Nat.shiftRight_eq_div_pow, Nat.testBit_shiftRight, Nat.testBit_xor]
  rw [show 7 + (10 + i) = 17 + i by omega, show 7 + 2 + (10 + i) = 19 + i by omega]

theorem S1_mod (e : Nat) (he : e < 2 ^ 32) : S1 e % 2 ^ 32 = bigSigma1 e := by
  rw [S1_alt]
  apply Nat.eq_of_testBit_eq
  intro i
  unfold bigSigma1
  rw [tb_mod32]
  show (decide (i < 32) && (Nat.xor (Nat.xor _ _) _).testBit i) = (rotr32 e 6 ^^^ rotr32 e 11 ^^^ rotr32 e 25).testBit i
  simp only [show ∀ a b : Nat, Nat.xor a b = a ^^^ b from fun _ _ => rfl, Nat.testBit_xor,
    tb_dupShift e _ i he (by omega : (6:Nat) ≤ 32), tb_dupShift e _ i he (by omega : (11:Nat) ≤ 32),
    tb_dupShift e _ i he (by omega : (25:Nat) ≤ 32),
    tb_rotr e 6 i (by omega) (by omega), tb_rotr e 11 i (by omega) (by omega),
    tb_rotr e 25 i (by omega) (by omega)]
  by_cases hi : i < 32
  · simp [hi]
  · simp [hi]

theorem S0_mod (a : Nat) (ha : a < 2 ^ 32) : S0 a % 2 ^ 32 = bigSigma0 a := by
  rw [S0_alt]
  apply Nat.eq_of_testBit_eq
  intro i
  unfold bigSigma0
  rw [tb_mod32]
  show (decide (i < 32) && (Nat.xor (Nat.xor _ _) _).testBit i) = (rotr32 a 2 ^^^ rotr32 a 13 ^^^ rotr32 a 22).testBit i
  simp only [show ∀ a b : Nat, Nat.xor a b = a ^^^ b from fun _ _ => rfl, Nat.testBit_xor,
    tb_dupShift a _ i ha (by omega : (2:Nat) ≤ 32), tb_dupShift a _ i ha (by omega : (13:Nat) ≤ 32),
    tb_dupShift a _ i ha (by omega : (22:Nat) ≤ 32),
    tb_rotr a 2 i (by omega) (by omega), tb_rotr a 13 i (by omega) (by omega),
    tb_rotr a 22 i (by omega) (by omega)]
  by_cases hi : i < 32
  · simp [hi]
  · simp [hi]

theorem s0_mod (x : Nat) (hx : x < 2 ^ 32) : s0 x % 2 ^ 32 = smallSigma0 x := by
  rw [s0_alt]
  apply Nat.eq_of_testBit_eq
  intro i
  unfold smallSigma0
  rw [tb_mod32]
  show (decide (i < 32) && (Nat.xor (Nat.xor _ _) _).testBit i) = (rotr32 x 7 ^^^ rotr32 x 18 ^^^ (x >>> 3)).testBit i
  simp only [show ∀ a b : Nat, Nat.xor a b = a ^^^ b from fun _ _ => rfl, Nat.testBit_xor,
    tb_dupShift x _ i hx (by omega : (7:Nat) ≤ 32), tb_dupShift x _ i hx (by omega : (18:Nat) ≤ 32),
    tb_rotr x 7 i (by omega) (by omega), tb_rotr x 18 i (by omega) (by omega)]
  by_cases hi : i < 32
  · simp [hi]
  · have h3 : (x >>> 3).testBit i = false := by
      rw [Nat.testBit_shiftRight]; exact tb_big hx (by omega)
    simp [hi, h3]

theorem s1_mod (x : Nat) (hx : x < 2 ^ 32) : s1 x % 2 ^ 32 = smallSigma1 x := by
  rw [s1_alt]
  apply Nat.eq_of_testBit_eq
  intro i
  unfold smallSigma1
  rw [tb_mod32]
  show (decide (i < 32) && (Nat.xor (Nat.xor _ _) _).testBit i) = (rotr32 x 17 ^^^ rotr32 x 19 ^^^ (x >>> 10)).testBit i
  simp only [show ∀ a b : Nat, Nat.xor a b = a ^^^ b from fun _ _ => rfl, Nat.testBit_xor,
    tb_dupShift x _ i hx (by omega : (17:Nat) ≤ 32), tb_dupShift x _ i hx (by omega : (19:Nat) ≤ 32),
    tb_rotr x 17 i (by omega) (by omega), tb_rotr x 19 i (by omega) (by omega)]
  by_cases hi : i < 32
  · simp [hi]
  · have h3 : (x >>> 10).testBit i = false := by
      rw [Nat.testBit_shiftRight]; exact tb_big hx (by omega)
    simp [hi, h3]

theorem ch_eq (e f g : Nat) (he : e < 2 ^ 32) (hf : f < 2 ^ 32) (hg : g < 2 ^ 32) :
    Nat.xor g (Nat.land e (Nat.xor f g)) = ch e f g := by
  apply Nat.eq_of_testBit_eq
  intro i
  unfold ch
  show (g ^^^ (e &&& (f ^^^ g))).testBit i = ((e &&& f) ^^^ ((e ^^^ w32) &&& g)).testBit i
  simp only [Nat.testBit_xor, Nat.testBit_and, tb_w32]
  by_cases hi : i < 32
  · simp only [hi, decide_true]
    cases e.testBit i <;> cases f.testBit i <;> cases g.testBit i <;> rfl
  · simp [tb_big (i := i) he (by omega), tb_big (i := i) hf (by omega), tb_big (i := i) hg (by omega)]

theorem maj_eq (a b c : Nat) :
    Nat.xor b (Nat.land (Nat.xor a b) (Nat.xor b c)) = maj a b c := by
  apply Nat.eq_of_testBit_eq
  intro i
  unfold maj
  show (b ^^^ ((a ^^^ b) &&& (b ^^^ c))).testBit i = ((a &&& b) ^^^ (a &&& c) ^^^ (b &&& c)).testBit i
  simp only [Nat.testBit_xor, Nat.testBit_and]
  cases a.testBit i <;> cases b.testBit i <;> cases c.testBit i <;> rfl

theorem lt32_of_land (x : Nat) : x &&& w32 < 2 ^ 32 := by
  rw [land_w32]; exact Nat.mod_lt _ (by decide)

theorem land_ff (x : Nat) : Nat.land 4294967295 x = x % 2 ^ 32 := by
  show 4294967295 &&& x = _
  rw [Nat.and_comm]
  exact land_w32 x

/-! ## One round -/

/-- All eight working variables are 32-bit words. -/
def Valid (s : Digest) : Prop :=
  s.a < 2 ^ 32 ∧ s.b < 2 ^ 32 ∧ s.c < 2 ^ 32 ∧ s.d < 2 ^ 32 ∧
  s.e < 2 ^ 32 ∧ s.f < 2 ^ 32 ∧ s.g < 2 ^ 32 ∧ s.h < 2 ^ 32

theorem add32_eq (x y : Nat) : add32 x y = (x + y) % 2 ^ 32 := land_w32 _

/-- The fast round as a digest update. -/
def fastRound (s : Digest) (k x : Nat) : Digest :=
  ⟨NA (T1 s.h s.e s.f s.g k x) s.a s.b s.c, s.a, s.b, s.c, NE s.d (T1 s.h s.e s.f s.g k x),
    s.e, s.f, s.g⟩

theorem round_eq (s : Digest) (k w : Nat) (hs : Valid s) : round s k w = fastRound s k w := by
  obtain ⟨ha, hb, hc, hd, he, hf, hg, hh⟩ := hs
  unfold round fastRound NA NE
  rw [land_ff, land_ff]
  simp only [add32_eq]
  have h1 := S1_mod s.e he
  have h0 := S0_mod s.a ha
  have hch := ch_eq s.e s.f s.g he hf hg
  have hmj := maj_eq s.a s.b s.c
  show _ = Digest.mk ((((k + w) + ((s.h + S1 s.e) + Nat.xor s.g (Nat.land s.e (Nat.xor s.f s.g))))
      + (S0 s.a + Nat.xor s.b (Nat.land (Nat.xor s.a s.b) (Nat.xor s.b s.c)))) % 2 ^ 32) s.a s.b s.c
      ((((k + w) + ((s.h + S1 s.e) + Nat.xor s.g (Nat.land s.e (Nat.xor s.f s.g)))) + s.d) % 2 ^ 32)
      s.e s.f s.g
  rw [hch, hmj, ← h1, ← h0]
  congr 1 <;> omega

theorem round_valid (s : Digest) (k w : Nat) : Valid s → Valid (round s k w) := by
  intro hs
  obtain ⟨ha, hb, hc, hd, he, hf, hg, hh⟩ := hs
  refine ⟨?_, ha, hb, hc, ?_, he, hf, hg⟩
  · exact lt32_of_land _
  · exact lt32_of_land _

/-! ## The rolling schedule (window lemmas adapted from the organizers' worked example) -/

structure Window where
  x0 : Nat
  x1 : Nat
  x2 : Nat
  x3 : Nat
  x4 : Nat
  x5 : Nat
  x6 : Nat
  x7 : Nat
  x8 : Nat
  x9 : Nat
  x10 : Nat
  x11 : Nat
  x12 : Nat
  x13 : Nat
  x14 : Nat
  x15 : Nat

def Window.toList (w : Window) : List Nat :=
  [w.x0, w.x1, w.x2, w.x3, w.x4, w.x5, w.x6, w.x7,
   w.x8, w.x9, w.x10, w.x11, w.x12, w.x13, w.x14, w.x15]

def Window.nextWord (w : Window) : Nat :=
  add32 (add32 (smallSigma1 w.x14) w.x9) (add32 (smallSigma0 w.x1) w.x0)

def Window.push (w : Window) (x : Nat) : Window :=
  ⟨w.x1, w.x2, w.x3, w.x4, w.x5, w.x6, w.x7, w.x8,
   w.x9, w.x10, w.x11, w.x12, w.x13, w.x14, w.x15, x⟩

def generate : Nat → Window → List Nat
  | 0, _ => []
  | k + 1, w => w.nextWord :: generate k (w.push w.nextWord)

theorem drop_last16 (pre : List Nat) (w : Window) :
    (pre ++ w.toList).drop ((pre ++ w.toList).length - 16) = w.toList := by
  simp [Window.toList]

theorem append_push (pre : List Nat) (w : Window) :
    (pre ++ w.toList) ++ [w.nextWord] = (pre ++ [w.x0]) ++ (w.push w.nextWord).toList := by
  simp [Window.toList, Window.push]

theorem extend_eq : ∀ k pre w, extendW k (pre ++ w.toList) = pre ++ w.toList ++ generate k w
  | 0, pre, w => by simp [extendW, generate]
  | k + 1, pre, w => by
    rw [extendW, drop_last16]
    show extendW k (pre ++ w.toList ++ [w.nextWord]) = _
    rw [append_push, extend_eq k (pre ++ [w.x0]) (w.push w.nextWord)]
    simp [generate, Window.toList, Window.push, List.append_assoc]

/-- Words consumed by the rounds: `x0` of each successive window. -/
def heads : Nat → Window → List Nat
  | 0, _ => []
  | n + 1, w => w.x0 :: heads n (w.push w.nextWord)

def after : Nat → Window → Window
  | 0, w => w
  | n + 1, w => after n (w.push w.nextWord)

theorem heads_length : ∀ n w, (heads n w).length = n
  | 0, _ => rfl
  | n + 1, w => by simp [heads, heads_length n]

theorem gen_split : ∀ n w, w.toList ++ generate n w = heads n w ++ (after n w).toList
  | 0, w => by simp [generate, heads, after]
  | n + 1, w => by
    rw [heads, after, List.cons_append, ← gen_split n (w.push w.nextWord)]
    simp [generate, Window.toList, Window.push]

/-! ## The loops -/

def WValid (w : Window) : Prop :=
  w.x0 < 2 ^ 32 ∧ w.x1 < 2 ^ 32 ∧ w.x2 < 2 ^ 32 ∧ w.x3 < 2 ^ 32 ∧ w.x4 < 2 ^ 32 ∧
  w.x5 < 2 ^ 32 ∧ w.x6 < 2 ^ 32 ∧ w.x7 < 2 ^ 32 ∧ w.x8 < 2 ^ 32 ∧ w.x9 < 2 ^ 32 ∧
  w.x10 < 2 ^ 32 ∧ w.x11 < 2 ^ 32 ∧ w.x12 < 2 ^ 32 ∧ w.x13 < 2 ^ 32 ∧ w.x14 < 2 ^ 32 ∧
  w.x15 < 2 ^ 32

theorem NW_eq (w : Window) (hw : WValid w) : NW w.x14 w.x9 w.x1 w.x0 = w.nextWord := by
  obtain ⟨h0, h1, _, _, _, _, _, _, _, _, _, _, _, _, h14, _⟩ := hw
  unfold Window.nextWord NW
  rw [land_ff]
  simp only [add32_eq]
  rw [← s1_mod _ h14, ← s0_mod _ h1]
  show ((s1 w.x14 + w.x9) + (s0 w.x1 + w.x0)) % 2 ^ 32 = _
  omega

theorem push_valid (w : Window) (x : Nat) (hw : WValid w) (hx : x < 2 ^ 32) :
    WValid (w.push x) := by
  obtain ⟨_, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15⟩ := hw
  exact ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, h15, hx⟩

theorem next_valid (w : Window) : w.nextWord < 2 ^ 32 := lt32_of_land _

/-- Pass the feed-forward of the final working variables to `k`. -/
def finK (s : Digest) (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) : Nat :=
  k (F32 0x6a09e667 s.a) (F32 0xbb67ae85 s.b) (F32 0x3c6ef372 s.c) (F32 0xa54ff53a s.d)
    (F32 0x510e527f s.e) (F32 0x9b05688c s.f) (F32 0x1f83d9ab s.g) (F32 0x5be0cd19 s.h)

def runB (n : Nat) (kb : List Nat) (w : Window) (s : Digest)
    (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) : Nat :=
  loopB n kb w.x0 w.x1 w.x2 w.x3 w.x4 w.x5 w.x6 w.x7 w.x8 w.x9 w.x10 w.x11 w.x12 w.x13 w.x14 w.x15
    s.a s.b s.c s.d s.e s.f s.g s.h k

def runA (n : Nat) (ka kb : List Nat) (w : Window) (s : Digest)
    (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) : Nat :=
  loopA n ka kb w.x0 w.x1 w.x2 w.x3 w.x4 w.x5 w.x6 w.x7 w.x8 w.x9 w.x10 w.x11 w.x12 w.x13 w.x14 w.x15
    s.a s.b s.c s.d s.e s.f s.g s.h k

theorem loopB_cons (n kk : Nat) (kb : List Nat) (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 a b c d e f g h : Nat)
    (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) :
    loopB (n + 1) (kk :: kb) x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 a b c d e f g h k =
    loopB n kb x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 0 (NA (T1 h e f g kk x0) a b c) a b c
      (NE d (T1 h e f g kk x0)) e f g k := rfl

theorem loopA_cons (n kk : Nat) (ka kb : List Nat) (x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 a b c d e f g h : Nat)
    (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) :
    loopA (n + 1) (kk :: ka) kb x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 a b c d e f g h k =
    loopA n ka kb x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 (NW x14 x9 x1 x0) (NA (T1 h e f g kk x0) a b c)
      a b c (NE d (T1 h e f g kk x0)) e f g k := rfl

theorem runB_cons (n kk : Nat) (kb : List Nat) (w : Window) (s : Digest)
    (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) :
    runB (n + 1) (kk :: kb) w s k = runB n kb (w.push 0) (fastRound s kk w.x0) k := by
  unfold runB
  rw [loopB_cons]
  rfl

theorem runA_cons (n kk : Nat) (ka kb : List Nat) (w : Window) (s : Digest)
    (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) :
    runA (n + 1) (kk :: ka) kb w s k
      = runA n ka kb (w.push (NW w.x14 w.x9 w.x1 w.x0)) (fastRound s kk w.x0) k := by
  unfold runA
  rw [loopA_cons]
  rfl

theorem runA_nil (kb : List Nat) (w : Window) (s : Digest)
    (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) :
    runA 0 [] kb w s k = runB 16 kb w s k := rfl

theorem rounds_append : ∀ (l1 l2 : List (Nat × Nat)) s, rounds (l1 ++ l2) s = rounds l2 (rounds l1 s)
  | [], _, _ => rfl
  | (k, w) :: l1, l2, s => by
    show rounds (l1 ++ l2) (round s k w) = _
    rw [rounds_append l1 l2]; rfl

theorem rounds_valid : ∀ (l : List (Nat × Nat)) s, Valid s → Valid (rounds l s)
  | [], _, h => h
  | (k, w) :: l, s, h => rounds_valid l (round s k w) (round_valid s k w h)

theorem zip_append_left_le : ∀ (a : List Nat) (l r : List Nat), a.length ≤ l.length →
    a.zip (l ++ r) = a.zip l
  | [], _, _, _ => by simp
  | _ :: _, [], _, h => by simp at h
  | x :: a, y :: l, r, h => by
    simp only [List.cons_append, List.zip_cons_cons]
    rw [zip_append_left_le a l r (by simp at h; omega)]

theorem loopB_eq (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) :
    ∀ (kb : List Nat) (w : Window) (s : Digest), kb.length ≤ 16 → Valid s →
    runB kb.length kb w s k = finK (rounds (kb.zip w.toList) s) k
  | [], w, s, _, _ => rfl
  | kk :: kb, w, s, hl, hs => by
    rw [List.length_cons, runB_cons, ← round_eq s kk w.x0 hs]
    rw [loopB_eq k kb (w.push 0) (round s kk w.x0) (by simp at hl; omega) (round_valid s kk w.x0 hs)]
    have hz : kb.zip (w.push 0).toList = kb.zip [w.x1, w.x2, w.x3, w.x4, w.x5, w.x6, w.x7, w.x8,
        w.x9, w.x10, w.x11, w.x12, w.x13, w.x14, w.x15] := by
      have : (w.push 0).toList = [w.x1, w.x2, w.x3, w.x4, w.x5, w.x6, w.x7, w.x8,
        w.x9, w.x10, w.x11, w.x12, w.x13, w.x14, w.x15] ++ [0] := rfl
      rw [this, zip_append_left_le _ _ _ (by simp at hl ⊢; omega)]
    rw [hz]
    rfl

theorem loopA_eq (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) :
    ∀ (ka kb : List Nat) (w : Window) (s : Digest), WValid w → Valid s →
    runA ka.length ka kb w s k = runB 16 kb (after ka.length w) (rounds (ka.zip (heads ka.length w)) s) k
  | [], kb, w, s, _, _ => rfl
  | kk :: ka, kb, w, s, hw, hs => by
    rw [List.length_cons, runA_cons, NW_eq w hw, ← round_eq s kk w.x0 hs]
    rw [loopA_eq k ka kb (w.push w.nextWord) (round s kk w.x0)
      (push_valid w w.nextWord hw (next_valid w)) (round_valid s kk w.x0 hs)]
    rfl

/-! ## One chain step -/

theorem KA_KB : K = KA ++ KB := by simp [KA, KB]

theorem F32_eq (c v : Nat) : F32 c v = add32 c v := by
  rw [add32_eq]; exact land_ff (c + v)

theorem stepN8_eq (d : Digest) (hd : Valid d) (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) :
    stepN8 d.a d.b d.c d.d d.e d.f d.g d.h k =
      k (sha256step d).a (sha256step d).b (sha256step d).c (sha256step d).d
        (sha256step d).e (sha256step d).f (sha256step d).g (sha256step d).h := by
  have hw0 : WValid ⟨d.a, d.b, d.c, d.d, d.e, d.f, d.g, d.h, 0x80000000, 0, 0, 0, 0, 0, 0, 256⟩ := by
    obtain ⟨ha, hb, hc, hd', he, hf, hg, hh⟩ := hd
    exact ⟨ha, hb, hc, hd', he, hf, hg, hh, (by decide : (0x80000000 : Nat) < 2 ^ 32),
      (by decide : (0 : Nat) < 2 ^ 32), (by decide : (0 : Nat) < 2 ^ 32),
      (by decide : (0 : Nat) < 2 ^ 32), (by decide : (0 : Nat) < 2 ^ 32),
      (by decide : (0 : Nat) < 2 ^ 32), (by decide : (0 : Nat) < 2 ^ 32),
      (by decide : (256 : Nat) < 2 ^ 32)⟩
  have hiv : Valid iv := ⟨by decide, by decide, by decide, by decide, by decide, by decide,
    by decide, by decide⟩
  have e1 : stepN8 d.a d.b d.c d.d d.e d.f d.g d.h k =
      runA 48 KA KB ⟨d.a, d.b, d.c, d.d, d.e, d.f, d.g, d.h, 0x80000000, 0, 0, 0, 0, 0, 0, 256⟩ iv k :=
    rfl
  have hlA : KA.length = 48 := rfl
  have hlB : KB.length = 16 := rfl
  rw [e1, ← hlA, loopA_eq k KA KB _ iv hw0 hiv, ← hlB,
    loopB_eq k KB _ _ (Nat.le_of_eq hlB) (rounds_valid _ _ hiv), ← rounds_append]
  have hs := extend_eq 48 [] ⟨d.a, d.b, d.c, d.d, d.e, d.f, d.g, d.h, 0x80000000, 0, 0, 0, 0, 0, 0, 256⟩
  simp only [List.nil_append] at hs
  have hsched : extendW 48 [d.a, d.b, d.c, d.d, d.e, d.f, d.g, d.h, 0x80000000, 0, 0, 0, 0, 0, 0, 256]
      = heads 48 ⟨d.a, d.b, d.c, d.d, d.e, d.f, d.g, d.h, 0x80000000, 0, 0, 0, 0, 0, 0, 256⟩ ++
        (after 48 ⟨d.a, d.b, d.c, d.d, d.e, d.f, d.g, d.h, 0x80000000, 0, 0, 0, 0, 0, 0, 256⟩).toList := by
    rw [← gen_split]; exact hs
  have hlen : KA.length = 48 := rfl
  have hr : KA.zip (heads KA.length ⟨d.a, d.b, d.c, d.d, d.e, d.f, d.g, d.h, 0x80000000, 0, 0, 0, 0, 0, 0, 256⟩) ++
      KB.zip (after KA.length ⟨d.a, d.b, d.c, d.d, d.e, d.f, d.g, d.h, 0x80000000, 0, 0, 0, 0, 0, 0, 256⟩).toList
      = K.zip (extendW 48 [d.a, d.b, d.c, d.d, d.e, d.f, d.g, d.h, 0x80000000, 0, 0, 0, 0, 0, 0, 256]) := by
    rw [hlen, hsched, KA_KB, List.zip_append (by rw [hlen]; simp [heads_length])]
  rw [hr]
  unfold finK sha256step compress
  simp only [F32_eq]
  rfl

theorem add32_lt (x y : Nat) : add32 x y < 2 ^ 32 := lt32_of_land _

theorem step_valid (d : Digest) : Valid (sha256step d) := by
  unfold sha256step compress
  exact ⟨add32_lt _ _, add32_lt _ _, add32_lt _ _, add32_lt _ _, add32_lt _ _,
    add32_lt _ _, add32_lt _ _, add32_lt _ _⟩

/- `stepF_eq : ∀ x0 … x7 k, stepF x0 … x7 k = stepN8 x0 … x7 k` by `rfl`, checked directly by the
kernel (constant subterms of `stepN8` are folded into numerals in `stepF`, which the kernel
evaluates). -/
open Lean Elab Term Command Meta in
run_cmd liftTermElabM do
  let ty ← instantiateMVars (← elabTerm (← `(∀ (x0 x1 x2 x3 x4 x5 x6 x7 : Nat)
      (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat),
      stepF x0 x1 x2 x3 x4 x5 x6 x7 k = stepN8 x0 x1 x2 x3 x4 x5 x6 x7 k)) none)
  let pf ← instantiateMVars (← elabTerm (← `(fun (x0 x1 x2 x3 x4 x5 x6 x7 : Nat)
      (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) =>
      @rfl Nat (stepF x0 x1 x2 x3 x4 x5 x6 x7 k))) none)
  addDecl (.thmDecl { name := `Submission.stepF_eq, levelParams := [], type := ty, value := pf })

theorem iterN_succ (t a b c d e f g h : Nat) :
    iterN (t + 1) a b c d e f g h = stepF a b c d e f g h (iterN t) := rfl

/- `stepF8_eq`: `stepF8` is eight nested `stepF`s, by `rfl` (checked directly by the kernel). -/
open Lean Elab Term Command Meta in
run_cmd liftTermElabM do
  let ty ← instantiateMVars (← elabTerm (← `(∀ (x0 x1 x2 x3 x4 x5 x6 x7 : Nat)
      (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat),
      stepF8 x0 x1 x2 x3 x4 x5 x6 x7 k =
        stepF x0 x1 x2 x3 x4 x5 x6 x7 (fun a b c d e f g h =>
        stepF a b c d e f g h (fun a b c d e f g h =>
        stepF a b c d e f g h (fun a b c d e f g h =>
        stepF a b c d e f g h (fun a b c d e f g h =>
        stepF a b c d e f g h (fun a b c d e f g h =>
        stepF a b c d e f g h (fun a b c d e f g h =>
        stepF a b c d e f g h (fun a b c d e f g h =>
        stepF a b c d e f g h k))))))))) none)
  let pf ← instantiateMVars (← elabTerm (← `(fun (x0 x1 x2 x3 x4 x5 x6 x7 : Nat)
      (k : Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat → Nat) =>
      @rfl Nat (stepF8 x0 x1 x2 x3 x4 x5 x6 x7 k))) none)
  addDecl (.thmDecl { name := `Submission.stepF8_eq, levelParams := [], type := ty, value := pf })

theorem iterN_succ_fun (t : Nat) :
    iterN (t + 1) = fun a b c d e f g h => stepF a b c d e f g h (iterN t) := rfl

theorem iterN_add8 (t a b c d e f g h : Nat) :
    iterN (t + 8) a b c d e f g h = stepF8 a b c d e f g h (iterN t) := by
  rw [stepF8_eq, iterN_succ_fun (t + 7), iterN_succ_fun (t + 6), iterN_succ_fun (t + 5),
    iterN_succ_fun (t + 4), iterN_succ_fun (t + 3), iterN_succ_fun (t + 2), iterN_succ_fun (t + 1),
    iterN_succ_fun t]

theorem iterN8_eq (r : Nat) : ∀ t a b c d e f g h,
    iterN8 r t a b c d e f g h = iterN (8 * t + r) a b c d e f g h
  | 0, a, b, c, d, e, f, g, h => by
    show iterN r a b c d e f g h = _
    rw [Nat.mul_zero, Nat.zero_add]
  | t + 1, a, b, c, d, e, f, g, h => by
    show stepF8 a b c d e f g h (iterN8 r t) = _
    rw [show 8 * (t + 1) + r = (8 * t + r) + 8 by omega, iterN_add8]
    have ih : iterN8 r t = iterN (8 * t + r) := by
      funext a b c d e f g h; exact iterN8_eq r t a b c d e f g h
    rw [ih]

theorem steps_split (n : Nat) :
    8 * Nat.shiftRight n 35 + Nat.land (Nat.shiftRight n 32) 7 = n >>> 32 := by
  have h35 : Nat.shiftRight n 35 = (n >>> 32) / 8 := by
    show n >>> 35 = _
    rw [Nat.shiftRight_eq_div_pow, Nat.shiftRight_eq_div_pow, show 35 = 32 + 3 from rfl,
      Nat.pow_add, Nat.div_div_eq_div_mul]
  have h7 : Nat.land (Nat.shiftRight n 32) 7 = (n >>> 32) % 8 := by
    show (n >>> 32) &&& (2 ^ 3 - 1) = _
    rw [Nat.and_two_pow_sub_one_eq_mod]
  rw [h35, h7]
  exact Nat.div_add_mod _ _

theorem enc_eq (a b c d e f g h : Nat) : enc a b c d e f g h = encodeDigest ⟨a, b, c, d, e, f, g, h⟩ := rfl

theorem iterDigest_zero (step : Digest → Digest) (d : Digest) : iterDigest step 0 d = d := rfl
theorem iterDigest_succ (step : Digest → Digest) (t : Nat) (d : Digest) :
    iterDigest step (t + 1) d = iterDigest step t (step d) := rfl

theorem iterN_eq : ∀ t (d : Digest), Valid d →
    iterN t d.a d.b d.c d.d d.e d.f d.g d.h = encodeDigest (iterSha t d)
  | 0, d, _ => by
    show enc d.a d.b d.c d.d d.e d.f d.g d.h = _
    rw [enc_eq]
    unfold iterSha
    rw [iterDigest_zero]
  | t + 1, d, hd => by
    rw [iterN_succ, stepF_eq, stepN8_eq d hd, iterN_eq t (sha256step d) (step_valid d)]
    unfold iterSha
    rw [iterDigest_succ]

theorem seed_valid (seed : Nat) : Valid (seedDigest seed) := by
  unfold seedDigest seedStep32
  exact ⟨lt32_of_land _, lt32_of_land _, lt32_of_land _, lt32_of_land _, lt32_of_land _,
    lt32_of_land _, lt32_of_land _, lt32_of_land _⟩

theorem impl_correct : ∀ n, impl n = sha256Spec n := by
  intro n
  show impl n = encodeDigest (iterSha (sha256Steps n) (seedDigest (sha256Seed n)))
  rw [← iterN_eq (sha256Steps n) (seedDigest (sha256Seed n)) (seed_valid _)]
  show iterN8 (Nat.land (Nat.shiftRight n 32) 7) (Nat.shiftRight n 35) _ _ _ _ _ _ _ _ = _
  rw [iterN8_eq, steps_split]
  rfl

end Submission
